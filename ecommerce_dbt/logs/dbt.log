  create view "warehouse"."intermediate"."int_fx_rates_to_usd__dbt_tmp" as (
    -- Grano: un registro por moneda + fecha de tasa.
-- Normaliza las tasas de la API a "cuántos USD vale 1 unidad de la moneda"
-- y les asigna un rango de vigencia [valid_from, valid_to).
--
-- Prioridad de fuentes para cada moneda y fecha:
--   1. identity: USD -> USD = 1
--   2. direct:   respuesta con base = moneda y rates.USD      (ej. EUR -> USD)
--   3. inverse:  1 / tasa de la respuesta con base = USD       (ej. 1 / USD -> GBP)
--
-- Vigencia: cada tasa vale desde su fecha hasta la siguiente tasa de la misma
-- moneda. La primera tasa de cada moneda se extiende hacia atrás
-- (valid_from = 1900-01-01) para cubrir las órdenes previas a la primera
-- respuesta de la API; esas órdenes se marcan con is_fx_rate_backfilled.

with rates as (

    select * from "warehouse"."staging"."stg_fx_rates"

),

identity_rates as (

    select distinct
        'USD'               as currency_code,
        rate_date,
        1.0                 as rate_to_usd,
        'identity'          as fx_rate_source,
        1                   as source_priority
    from rates

),

direct_rates as (

    select
        currency_from       as currency_code,
        rate_date,
        rate                as rate_to_usd,
        'direct'            as fx_rate_source,
        2                   as source_priority
    from rates
    where currency_to = 'USD'
      and currency_from <> 'USD'

),

inverse_rates as (

    select
        currency_to         as currency_code,
        rate_date,
        1.0 / rate          as rate_to_usd,
        'inverse'           as fx_rate_source,
        3                   as source_priority
    from rates
    where currency_from = 'USD'
      and currency_to <> 'USD'

),

unioned as (

    select * from identity_rates
    union all
    select * from direct_rates
    union all
    select * from inverse_rates

),

best_rate_per_day as (

    select *
    from unioned
    qualify row_number() over (
        partition by currency_code, rate_date
        order by source_priority
    ) = 1

),

with_validity as (

    select
        currency_code,
        rate_date,
        cast(rate_to_usd as decimal(18, 6))     as rate_to_usd,
        fx_rate_source,
        lead(rate_date) over (
            partition by currency_code order by rate_date
        )                                       as next_rate_date,
        row_number() over (
            partition by currency_code order by rate_date
        ) = 1                                   as is_first_rate

    from best_rate_per_day

)

select
    currency_code || '_' || strftime(rate_date, '%Y-%m-%d')     as fx_rate_to_usd_id,
    currency_code,
    rate_date,
    rate_to_usd,
    fx_rate_source,
    case when is_first_rate then date '1900-01-01' else rate_date end
                                                                as valid_from,
    coalesce(next_rate_date, date '9999-12-31')                 as valid_to

from with_validity
  );

